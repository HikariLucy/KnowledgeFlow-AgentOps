# Application Configuration
APP_NAME=KnowledgeFlow RAG
APP_ENV=development

# Google Gemini LLM & Embeddings (Optional for Phase 0/1)
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Vector Store & Semantic Retrieval Configuration
EMBEDDING_DIMENSION=768
RETRIEVAL_TOP_K=4
VECTORSTORE_DIR=vectorstore

# RAG Generation & Grounding Configuration (Phase 3)
RAG_MIN_SIMILARITY=0.60
LLM_TEMPERATURE=1.0

# Local JSON observability (stderr; no external service)
OBS_ENABLED=false
OBS_EXECUTION_MODE=unknown
# Optional: set a random secret of at least 32 bytes for stable pseudonymous sessions.
# Leave OBS_SESSION_KEY unset to use a random per-process key.
# OBS_SESSION_KEY=<generate locally; never commit the real value>

# Bounded local persistence for prolonged sessions. See docs/13-agregacion-metricas.md.
OBS_STORE_ENABLED=false
OBS_STORE_PATH=data/observability/events.sqlite3
OBS_RETENTION_DAYS=7
OBS_MAX_EVENTS=50000
OBS_MAX_BYTES=67108864
# Independent administrative read key, at least 32 bytes; unset disables read access.
# OBS_READ_KEY=<generate locally; never commit the real value>
# Modes: offline | mock | live | unknown | offline_mock (legacy, never merged).

# Local-only read dashboard: http://127.0.0.1:8000/dashboard (user: observer).
# Bind Uvicorn to loopback and use --no-proxy-headers; never publish behind a proxy.
OBS_DASHBOARD_ENABLED=false
# Independent password: 32+ ASCII characters, different from OBS_READ_KEY.
# OBS_DASHBOARD_PASSWORD=<set privately in your local environment>
